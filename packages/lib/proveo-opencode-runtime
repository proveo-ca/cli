#!/usr/bin/env node
// SPEC: _spec/defs/opencode/engine-local-history.puml, _spec/defs/opencode/native-v2-integration.puml

const { spawn } = require("node:child_process")
const { cpSync, existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } = require("node:fs")
const { constants, homedir, tmpdir } = require("node:os")
const { basename, join } = require("node:path")

const valuedFlags = new Set(["--log-level", "--completions", "--server", "--session", "-s", "--prompt"])
const bareCommands = new Set(["debug", "serve", "service", "acp", "mcp", "plugin", "upgrade", "update", "uninstall", "pair"])
const diagnostics = new Set(["--version", "-v", "--help", "-h", "--completions"])

function nativeCommand(binary, args) {
  const split = args.indexOf("--")
  const flags = args.slice(0, split < 0 ? args.length : split)
  let command
  for (let i = 0; i < flags.length; i++) {
    if (valuedFlags.has(flags[i])) i++
    else if (!flags[i].startsWith("-")) {
      command = flags[i]
      break
    }
  }
  const add = []
  if (command === "run" && !args.includes("--auto")) add.push("--auto")
  if (!bareCommands.has(command) && !args.includes("--standalone") &&
      !args.some(arg => arg === "--server" || arg.startsWith("--server="))) add.push("--standalone")
  return [binary, ...flags, ...add, ...(split < 0 ? [] : args.slice(split))]
}

function diagnostic(args) {
  const split = args.indexOf("--")
  return args.slice(0, split < 0 ? args.length : split).some(arg => diagnostics.has(arg))
}

async function throwaway(native, args) {
  const root = mkdtempSync(join(tmpdir(), "proveo-opencode-throwaway-"))
  const env = { ...process.env, XDG_DATA_HOME: join(root, "data"), XDG_STATE_HOME: join(root, "state"),
    OPENCODE_DB: join(root, "data/opencode/opencode.db"), TMPDIR: join(root, "tmp") }
  const source = env.OPENCODE_CONFIG_DIR || join(env.XDG_CONFIG_HOME || join(env.PROVEO_HOME || env.HOME || homedir(), ".config"), "opencode")
  env.OPENCODE_CONFIG_DIR = join(root, "config/opencode")
  let child
  const handlers = new Map(["SIGINT", "SIGTERM", "SIGHUP"].map(sig => [sig, () => child?.kill(sig)]))
  try {
    for (const [sig, handler] of handlers) process.on(sig, handler)
    for (const dir of [join(root, "data/opencode"), env.TMPDIR, env.OPENCODE_CONFIG_DIR]) {
      mkdirSync(dir, { recursive: true, mode: 0o700 })
    }
    if (existsSync(source)) cpSync(source, env.OPENCODE_CONFIG_DIR, {
      recursive: true, dereference: true, filter: file => !/^service.*\.json$/.test(basename(file)),
    })
    writeFileSync(join(env.OPENCODE_CONFIG_DIR, "service.json"), JSON.stringify({ disabled: true }))
    child = spawn(native, args, { env, stdio: "inherit" })
    return await new Promise((resolve, reject) => {
      child.once("error", reject)
      child.once("exit", (code, signal) => resolve(code ?? (128 + constants.signals[signal])))
    })
  } finally {
    rmSync(root, { recursive: true, force: true })
    for (const [sig, handler] of handlers) process.off(sig, handler)
  }
}

async function main() {
  const [native, ...args] = process.argv.slice(2)
  if (!native) {
    console.error("proveo: OpenCode runtime requires the native executable")
    return 64
  }
  try {
    if (process.env.PROVEO_GIT_SYNC_MSG_INFLIGHT === "1" || diagnostic(args)) return await throwaway(native, args)
    process.execve(native, nativeCommand(native, args), process.env)
  } catch (err) {
    console.error(`proveo: cannot start OpenCode (${native}): ${err.message}`)
    return 127
  }
}

module.exports = { nativeCommand, diagnostic }
if (require.main === module) main().then(code => { process.exitCode = code })
